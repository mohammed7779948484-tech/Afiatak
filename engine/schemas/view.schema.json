{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["id", "title", "diagramType", "model", "include"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "title": {"type": "string", "minLength": 1},
    "diagramType": {"const": "use_case"},
    "model": {"type": "string"}, "include": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "relations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "layoutProfile": {"type": "string"}, "outputTargets": {"type": "array", "items": {"enum": ["png", "svg"]}, "uniqueItems": true, "minItems": 2, "maxItems": 2, "allOf": [{"contains": {"const": "svg"}}, {"contains": {"const": "png"}}]},
    "approval": {"enum": ["draft", "reviewed", "approved"]},
    "visualReview": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewer", "reviewedAt", "previewHash"],
      "properties": {
        "status": {"enum": ["generated", "internally-reviewed", "awaiting-user-approval", "approved"]}, "reviewer": {"type": "string", "minLength": 1},
        "reviewedAt": {"type": "string", "format": "date-time"},
        "notes": {"type": "string", "minLength": 1},
        "previewHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "options": {"type": "object"}
  }
}
