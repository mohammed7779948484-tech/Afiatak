{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "briefDescription", "primaryActor", "preconditions",
    "mainFlow", "alternateFlows", "postconditions", "sourceRefs"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^uc\\.[a-z0-9][a-z0-9._-]*$"},
    "name": {"type": "string", "minLength": 1},
    "briefDescription": {"type": "string", "minLength": 1},
    "primaryActor": {"type": "string"},
    "secondaryActors": {"type": "array", "items": {"type": "string"}},
    "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "mainFlow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "actor", "action"],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "actor": {"type": "string"},
          "action": {"type": "string"}
        }
      }
    },
    "alternateFlows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "condition", "steps", "outcome"],
        "properties": {
          "name": {"type": "string"},
          "condition": {"type": "string"},
          "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "outcome": {"type": "string"}
        }
      }
    },
    "postconditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source"],
        "properties": {
          "source": {"type": "string"},
          "section": {"type": "string"},
          "page": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": true
      }
    }
  }
}
