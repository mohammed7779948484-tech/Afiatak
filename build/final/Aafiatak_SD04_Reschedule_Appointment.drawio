F2FC;strokeColor=#326C96;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3088.0" y="2403" width="32" height="105" as="geometry" /></mxCell><mxCell id="activation-24" value="" style="rounded=0;html=1;fillColor=#E8F2FC;strokeColor=#326C96;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4380.0" y="2548" width="32" height="105" as="geometry" /></mxCell><mxCell id="activation-25" value="" style="rounded=0;html=1;fillColor=#E8F2FC;strokeColor=#326C96;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5672.0" y="2838" width="32" height="105" as="geometry" /></mxCell><mxCell id="message-26" value="" style="html=1;endArrow=block;dashed=0;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520.0" y="820" as="sourcePoint" /><mxPoint x="1812.0" y="820" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-27" value="1. Open CONFIRMED Appointment and choose Reschedule" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="543.0" y="743" width="1246.0" height="64" as="geometry" /></mxCell><mxCell id="message-28" value="" style="html=1;endArrow=block;dashed=0;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1812.0" y="965" as="sourcePoint" /><mxPoint x="3104.0" y="965" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-29" value="2. Load reschedule context" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2125.0" y="888" width="666" height="64" as="geometry" /></mxCell><mxCell id="message-30" value="" style="html=1;endArrow=block;dashed=0;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3104.0" y="1110" as="sourcePoint" /><mxPoint x="4396.0" y="1110" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-31" value="3. Read Appointment snapshot, history and current&lt;br/&gt;capacity" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="3141.0" y="985" width="1218" height="112" as="geometry" /></mxCell><mxCell id="message-32" value="" style="html=1;endArrow=open;dashed=1;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4396.0" y="1255" as="sourcePoint" /><mxPoint x="3104.0" y="1255" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-33" value="4. Return current booking and governing terms" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="3189.0" y="1178" width="1122" height="64" as="geometry" /></mxCell><mxCell id="message-34" value="" style="html=1;endArrow=open;dashed=1;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3104.0" y="1400" as="sourcePoint" /><mxPoint x="1812.0" y="1400" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-35" value="5. Display current snapshot and permitted destination&lt;br/&gt;context" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1835.0" y="1275" width="1246.0" height="112" as="geometry" /></mxCell><mxCell id="message-36" value="" style="html=1;endArrow=block;dashed=0;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520.0" y="1545" as="sourcePoint" /><mxPoint x="1812.0" y="1545" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-37" value="6. Select agreed new day/group/session" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="689.0" y="1468" width="954" height="64" as="geometry" /></mxCell><mxCell id="message-38" value="" style="html=1;endArrow=block;dashed=0;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1812.0" y="1690" as="sourcePoint" /><mxPoint x="3104.0" y="1690" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-39" value="7. Validate destination" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2161.0" y="1613" width="594" height="64" as="geometry" /></mxCell><mxCell id="message-40" value="" style="html=1;endArrow=block;dashed=0;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3104.0" y="1835" as="sourcePoint" /><mxPoint x="4396.0" y="1835" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-41" value="8. Check same ServiceOffering, same terms and&lt;br/&gt;destination bookability" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="3189.0" y="1710" width="1122" height="112" as="geometry" /></mxCell><mxCell id="message-42" value="" style="html=1;endArrow=open;dashed=1;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4396.0" y="1980" as="sourcePoint" /><mxPoint x="3104.0" y="1980" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-43" value="9. Destination valid and currently bookable" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="3213.0" y="1903" width="1074" height="64" as="geometry" /></mxCell><mxCell id="message-44" value="" style="html=1;endArrow=open;dashed=1;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3104.0" y="2125" as="sourcePoint" /><mxPoint x="1812.0" y="2125" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-45" value="10. Display valid proposed move" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2065.0" y="2048" width="786" height="64" as="geometry" /></mxCell><mxCell id="message-46" value="" style="html=1;endArrow=block;dashed=0;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520.0" y="2270" as="sourcePoint" /><mxPoint x="1812.0" y="2270" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-47" value="11. Confirm reschedule and record reason" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="665.0" y="2193" width="1002" height="64" as="geometry" /></mxCell><mxCell id="message-48" value="" style="html=1;endArrow=block;dashed=0;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1812.0" y="2415" as="sourcePoint" /><mxPoint x="3104.0" y="2415" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-49" value="12. Commit reschedule" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2185.0" y="2338" width="546" height="64" as="geometry" /></mxCell><mxCell id="message-50" value="" style="html=1;endArrow=block;dashed=0;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3104.0" y="2560" as="sourcePoint" /><mxPoint x="4396.0" y="2560" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-51" value="13. Atomically secure destination, update Appointment,&lt;br/&gt;release old seat and write history" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="3127.0" y="2435" width="1246.0" height="112" as="geometry" /></mxCell><mxCell id="message-52" value="" style="html=1;endArrow=open;dashed=1;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4396.0" y="2705" as="sourcePoint" /><mxPoint x="3104.0" y="2705" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-53" value="14. Reschedule committed; Appointment remains&lt;br/&gt;CONFIRMED" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="3189.0" y="2580" width="1122" height="112" as="geometry" /></mxCell><mxCell id="message-54" value="" style="html=1;endArrow=block;dashed=0;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3104.0" y="2850" as="sourcePoint" /><mxPoint x="5688.0" y="2850" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-55" value="15. Send appointment-change notification" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="3895.0" y="2773" width="1002" height="64" as="geometry" /></mxCell><mxCell id="message-56" value="" style="html=1;endArrow=open;dashed=1;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="5688.0" y="2995" as="sourcePoint" /><mxPoint x="3104.0" y="2995" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-57" value="16. Notification accepted" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="4075.0" y="2918" width="642" height="64" as="geometry" /></mxCell><mxCell id="message-58" value="" style="html=1;endArrow=block;dashed=0;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="5688.0" y="3140" as="sourcePoint" /><mxPoint x="6980.0" y="3140" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-59" value="17. Deliver new agreed arrival details" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="5857.0" y="3063" width="954" height="64" as="geometry" /></mxCell><mxCell id="message-60" value="" style="html=1;endArrow=open;dashed=1;dashPattern=13 10;strokeColor=#162F46;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3104.0" y="3285" as="sourcePoint" /><mxPoint x="1812.0" y="3285" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label-61" value="18. Display successful reschedule" style="text;html=1;align=center;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2041.0" y="3208" width="834" height="64" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>