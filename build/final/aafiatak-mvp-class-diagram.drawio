<mxfile host="app.diagrams.net" version="31.1.8" type="device"><diagram name="MVP Class Diagram" id="aafiatak-mvp-class"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="9000" pageHeight="6364" math="0" shadow="0"><root><mxCell id="0" value="" /><mxCell id="1" value="" parent="0" /><mxCell id="page-2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="9000" height="6364" as="geometry" /></mxCell><mxCell id="title-3" value="Class Diagram — Aafiatak Medical Appointment Booking System (MVP)" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#182B3D;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200" y="45" width="4600" height="70" as="geometry" /></mxCell><mxCell id="zone-4" value="IDENTITY &amp; ACCESS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#D5DEE9;fontColor=#4A5A6A;fontStyle=1;fontSize=16;verticalAlign=top;align=left;spacingTop=10;spacingLeft=15;opacity=40;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="180" y="250" width="2150" height="2100" as="geometry" /></mxCell><mxCell id="zone-5" value="PLATFORM &amp; REFERENCE DATA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7FC;strokeColor=#D5DEE9;fontColor=#4A5A6A;fontStyle=1;fontSize=16;verticalAlign=top;align=left;spacingTop=10;spacingLeft=15;opacity=40;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="2400" y="250" width="1800" height="1800" as="geometry" /></mxCell><mxCell id="zone-6" value="FACILITY &amp; MEDICAL OFFERING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAF5;strokeColor=#D5DEE9;fontColor=#4A5A6A;fontStyle=1;fontSize=16;verticalAlign=top;align=left;spacingTop=10;spacingLeft=15;opacity=40;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="4250" y="250" width="2950" height="1800" as="geometry" /></mxCell><mxCell id="zone-7" value="SCHEDULE &amp; DIGITAL AVAILABILITY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBFB;strokeColor=#D5DEE9;fontColor=#4A5A6A;fontStyle=1;fontSize=16;verticalAlign=top;align=left;spacingTop=10;spacingLeft=15;opacity=40;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="4250" y="2150" width="3700" height="1250" as="geometry" /></mxCell><mxCell id="zone-8" value="APPOINTMENT &amp; PAYMENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBF3;strokeColor=#D5DEE9;fontColor=#4A5A6A;fontStyle=1;fontSize=16;verticalAlign=top;align=left;spacingTop=10;spacingLeft=15;opacity=40;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1950" y="3500" width="3100" height="1600" as="geometry" /></mxCell><mxCell id="zone-9" value="VISIT, QUEUE &amp; OPERATIONAL EXCEPTIONS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF6F6;strokeColor=#D5DEE9;fontColor=#4A5A6A;fontStyle=1;fontSize=16;verticalAlign=top;align=left;spacingTop=10;spacingLeft=15;opacity=40;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="5100" y="4200" width="3150" height="1300" as="geometry" /></mxCell><mxCell id="class.c01-10" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;User&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- userId&lt;br/&gt;- normalizedPhone&lt;br/&gt;- phoneVerifiedAt&lt;br/&gt;- accountStatus&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ requestOtp()&lt;br/&gt;+ verifyOtp()&lt;br/&gt;+ revokeSession()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Maintain the globally unique verified human identity and authentication state.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="650" width="520" height="500" as="geometry" /></mxCell><mxCell id="class.c02-11" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;Patient&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- patientId&lt;br/&gt;- fullName&lt;br/&gt;- basicProfileData&lt;br/&gt;- active&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ updateProfile()&lt;br/&gt;+ viewOwnAppointments()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Represent Patient-specific non-clinical profile data linked to one User identity.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="430" width="520" height="420" as="geometry" /></mxCell><mxCell id="class.c03-12" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;FacilityUser&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- facilityUserId&lt;br/&gt;- role&lt;br/&gt;- status&lt;br/&gt;- permissions&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ assignApprovedRole()&lt;br/&gt;+ enable()&lt;br/&gt;+ disable()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Represent a provisioned User's role and access inside one participating Facility.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="980" width="520" height="470" as="geometry" /></mxCell><mxCell id="class.c04-13" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;PlatformRoleAssignment&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- assignmentId&lt;br/&gt;- role&lt;br/&gt;- status&lt;br/&gt;- permissions&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ assignApprovedRole()&lt;br/&gt;+ enable()&lt;br/&gt;+ disable()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Represent a controlled platform-role relationship for a User, including Platform Administrator/platform-staff access.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1650" y="980" width="520" height="470" as="geometry" /></mxCell><mxCell id="class.c05-14" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;FacilityOnboardingRequest&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- requestId&lt;br/&gt;- status&lt;br/&gt;- submittedAt&lt;br/&gt;- decisionAt&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ requestAdditionalInformation()&lt;br/&gt;+ approve()&lt;br/&gt;+ reject()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Preserve the platform-side intake/review decision for facility onboarding.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1650" y="430" width="520" height="470" as="geometry" /></mxCell><mxCell id="class.c06-15" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;AuditRecord&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- auditId&lt;br/&gt;- action&lt;br/&gt;- timestamp&lt;br/&gt;- reason&lt;br/&gt;- source&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ recordChange()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Preserve auditable actor/time/reason/source information for important changes.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="1800" width="520" height="470" as="geometry" /></mxCell><mxCell id="class.c07-16" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;Notification&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- notificationId&lt;br/&gt;- type&lt;br/&gt;- status&lt;br/&gt;- createdAt&lt;br/&gt;- deliveredAt&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ markDelivered()&lt;br/&gt;+ markFailed()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Represent approved in-application/system notification records.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="1250" width="520" height="430" as="geometry" /></mxCell><mxCell id="class.c08-17" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;Region&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- regionId&lt;br/&gt;- name&lt;br/&gt;- active&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ activate()&lt;br/&gt;+ deactivate()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Provide platform-level region reference data.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2500" y="520" width="480" height="400" as="geometry" /></mxCell><mxCell id="class.c09-18" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;City&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- cityId&lt;br/&gt;- name&lt;br/&gt;- active&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ activate()&lt;br/&gt;+ deactivate()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Provide platform-level city reference data inside a Region.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="3080" y="520" width="480" height="400" as="geometry" /></mxCell><mxCell id="class.c10-19" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;FacilityType&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- facilityTypeId&lt;br/&gt;- name&lt;br/&gt;- active&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ activate()&lt;br/&gt;+ deactivate()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Classify participating Facilities using platform reference data.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="3660" y="520" width="480" height="400" as="geometry" /></mxCell><mxCell id="class.c11-20" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;Facility&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- facilityId&lt;br/&gt;- name&lt;br/&gt;- status&lt;br/&gt;- contactNumber&lt;br/&gt;- workingHours&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ updateProfile()&lt;br/&gt;+ activate()&lt;br/&gt;+ suspend()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Represent the participating health facility account without replacing its internal HIS/scheduling system.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="4400" y="520" width="550" height="470" as="geometry" /></mxCell><mxCell id="class.c12-21" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;FacilityBranch&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- branchId&lt;br/&gt;- name&lt;br/&gt;- address&lt;br/&gt;- mapLocation&lt;br/&gt;- contactNumber&lt;br/&gt;- localTimeZone&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ updateContactData()&lt;br/&gt;+ updateWorkingHours()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Represent the branch context in which bookings, releases, and local-time rules are interpreted.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="5100" y="520" width="550" height="500" as="geometry" /></mxCell><mxCell id="class.c13-22" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;Department&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- departmentId&lt;br/&gt;- name&lt;br/&gt;- active&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ activate()&lt;br/&gt;+ deactivate()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Provide a platform reference Department that Facilities may associate with themselves.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2600" y="1120" width="500" height="400" as="geometry" /></mxCell><mxCell id="class.c14-23" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;Specialty&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- specialtyId&lt;br/&gt;- name&lt;br/&gt;- active&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ activate()&lt;br/&gt;+ deactivate()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Provide a platform reference Specialty associated with Facilities, Doctors, and services.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="3250" y="1120" width="500" height="400" as="geometry" /></mxCell><mxCell id="class.c15-24" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;Doctor&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- doctorId&lt;br/&gt;- name&lt;br/&gt;- photo&lt;br/&gt;- qualification&lt;br/&gt;- biography&lt;br/&gt;- active&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ updateProfile()&lt;br/&gt;+ linkLoginAccess()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Represent the Doctor's public/operational profile separately from the User authentication identity.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="5800" y="1220" width="550" height="500" as="geometry" /></mxCell><mxCell id="class.c16-25" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;ServiceOffering&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- serviceOfferingId&lt;br/&gt;- serviceName&lt;br/&gt;- amount&lt;br/&gt;- currency&lt;br/&gt;- estimatedDuration&lt;br/&gt;- bookingPolicy&lt;br/&gt;- cancellationPolicy&lt;br/&gt;- cancellationWindow&lt;br/&gt;- noShowPolicy&lt;br/&gt;- reconfirmationEnabled&lt;br/&gt;- attendanceInstructions&lt;br/&gt;- active&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ setAmount()&lt;br/&gt;+ setBookingPolicy()&lt;br/&gt;+ configurePolicies()&lt;br/&gt;+ activate()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Define the authoritative service terms used to prepare new AvailabilityRelease records.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="6500" y="1020" width="620" height="760" as="geometry" /></mxCell><mxCell id="class.c17-26" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;DoctorSchedule&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- scheduleId&lt;br/&gt;- dayOrDate&lt;br/&gt;- startTime&lt;br/&gt;- endTime&lt;br/&gt;- active&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ defineWindow()&lt;br/&gt;+ updateWindow()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Represent theoretical/basic Doctor working windows before digital availability is published.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="4400" y="2600" width="550" height="470" as="geometry" /></mxCell><mxCell id="class.c18-27" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;ScheduleException&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- scheduleExceptionId&lt;br/&gt;- date&lt;br/&gt;- type&lt;br/&gt;- reason&lt;br/&gt;- status&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ recordException()&lt;br/&gt;+ deactivate()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Represent a planned leave, closure, or planned scheduling exception before publication.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="5100" y="2600" width="550" height="450" as="geometry" /></mxCell><mxCell id="class.c19-28" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;AvailabilityRelease&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- releaseId&lt;br/&gt;- date&lt;br/&gt;- receptionPeriod&lt;br/&gt;- published&lt;br/&gt;- held&lt;br/&gt;- confirmed&lt;br/&gt;- withdrawnToFacility&lt;br/&gt;- /remaining&lt;br/&gt;- amountSnapshot&lt;br/&gt;- currencySnapshot&lt;br/&gt;- bookingPolicySnapshot&lt;br/&gt;- cancellationPolicySnapshot&lt;br/&gt;- cancellationWindowSnapshot&lt;br/&gt;- noShowPolicySnapshot&lt;br/&gt;- state&lt;br/&gt;- lastUpdatedAt&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ publish()&lt;br/&gt;+ freeze()&lt;br/&gt;+ close()&lt;br/&gt;+ cancel()&lt;br/&gt;+ calculateRemaining()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Own the bounded digital capacity allocated to Aafiatak for one branch/doctor/service/date/session.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="5800" y="2300" width="650" height="860" as="geometry" /></mxCell><mxCell id="class.c20-29" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;ArrivalGroup&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- arrivalGroupId&lt;br/&gt;- sequence&lt;br/&gt;- startAt&lt;br/&gt;- endAt&lt;br/&gt;- capacity&lt;br/&gt;- held&lt;br/&gt;- confirmed&lt;br/&gt;- withdrawnToFacility&lt;br/&gt;- /remaining&lt;br/&gt;- state&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ isBookable()&lt;br/&gt;+ freeze()&lt;br/&gt;+ close()&lt;br/&gt;+ calculateRemaining()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Represent one sequential arrival window inside an AvailabilityRelease.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="6650" y="2400" width="600" height="650" as="geometry" /></mxCell><mxCell id="class.c21-30" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;CapacityWithdrawal&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- withdrawalId&lt;br/&gt;- quantity&lt;br/&gt;- source&lt;br/&gt;- reason&lt;br/&gt;- occurredAt&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ execute()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Record the atomic one-way transfer of valid unused Aafiatak capacity to the Facility's internal schedule.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="7400" y="2500" width="520" height="430" as="geometry" /></mxCell><mxCell id="class.c22-31" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;ReservationHold&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- reservationHoldId&lt;br/&gt;- state&lt;br/&gt;- createdAt&lt;br/&gt;- expiresAt&lt;br/&gt;- idempotencyKey&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ consume()&lt;br/&gt;+ expire()&lt;br/&gt;+ release()&lt;br/&gt;+ isActive()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Temporarily protect exactly one valid booking capacity unit against double booking.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2100" y="3650" width="600" height="500" as="geometry" /></mxCell><mxCell id="class.c23-32" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;AvailabilityAlertSubscription&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- subscriptionId&lt;br/&gt;- targetDate&lt;br/&gt;- status&lt;br/&gt;- createdAt&lt;br/&gt;- lastNotifiedAt&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ markNotified()&lt;br/&gt;+ expire()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Record Patient interest in returned availability without reserving capacity or granting priority.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2800" y="3650" width="600" height="480" as="geometry" /></mxCell><mxCell id="class.c24-33" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;Appointment&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- appointmentId&lt;br/&gt;- status&lt;br/&gt;- bookingNumber&lt;br/&gt;- verificationToken&lt;br/&gt;- confirmedAt&lt;br/&gt;- amountSnapshot&lt;br/&gt;- currencySnapshot&lt;br/&gt;- bookingPolicySnapshot&lt;br/&gt;- cancellationPolicySnapshot&lt;br/&gt;- cancellationWindowSnapshot&lt;br/&gt;- noShowPolicySnapshot&lt;br/&gt;- arrivalWindowSnapshot&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ cancelByPatient()&lt;br/&gt;+ cancelByFacility()&lt;br/&gt;+ reschedule()&lt;br/&gt;+ reconfirmAttendance()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Represent the confirmed booking commitment and preserve its historical booking terms.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="3500" y="3500" width="680" height="780" as="geometry" /></mxCell><mxCell id="class.c25-34" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;AppointmentStatusHistory&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- historyId&lt;br/&gt;- previousSchedulingData&lt;br/&gt;- newSchedulingData&lt;br/&gt;- changedAt&lt;br/&gt;- reason&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ recordChange()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Preserve auditable appointment cancellation/rescheduling history without rewriting the original record.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="4350" y="3500" width="620" height="500" as="geometry" /></mxCell><mxCell id="class.c26-35" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;PaymentIntent&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- paymentIntentId&lt;br/&gt;- amount&lt;br/&gt;- currency&lt;br/&gt;- state&lt;br/&gt;- externalReference&lt;br/&gt;- createdAt&lt;br/&gt;- expiresAt&lt;br/&gt;- idempotencyKey&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ markProcessing()&lt;br/&gt;+ verifyResult()&lt;br/&gt;+ markUnderReview()&lt;br/&gt;+ startRefund()&lt;br/&gt;+ markRefunded()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Represent the independent full electronic payment/refund lifecycle for FULL_PAYMENT_REQUIRED.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="4350" y="4150" width="620" height="590" as="geometry" /></mxCell><mxCell id="class.c27-36" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;VisitInstance&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- visitInstanceId&lt;br/&gt;- status&lt;br/&gt;- arrivalTime&lt;br/&gt;- serviceStart&lt;br/&gt;- serviceEnd&lt;br/&gt;- lateAccepted&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ checkIn()&lt;br/&gt;+ startService()&lt;br/&gt;+ complete()&lt;br/&gt;+ markNotCompleted()&lt;br/&gt;+ markNoShow()&lt;br/&gt;+ correctCheckIn()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Represent what actually happens operationally on the service day, separately from Appointment status.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="5250" y="4400" width="600" height="600" as="geometry" /></mxCell><mxCell id="class.c28-37" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;QueueEntry&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- queueEntryId&lt;br/&gt;- status&lt;br/&gt;- createdAt&lt;br/&gt;- calledAt&lt;br/&gt;- completedAt&lt;br/&gt;- manualHandling&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ call()&lt;br/&gt;+ markDone()&lt;br/&gt;+ remove()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Represent the Patient's lightweight Aafiatak queue presence inside an ArrivalGroup.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="6000" y="4500" width="560" height="500" as="geometry" /></mxCell><mxCell id="class.c29-38" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;OperationalException&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- operationalExceptionId&lt;br/&gt;- type&lt;br/&gt;- status&lt;br/&gt;- openedAt&lt;br/&gt;- closedAt&lt;br/&gt;- reason&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ open()&lt;br/&gt;+ recordAffectedAppointmentOutcome()&lt;br/&gt;+ close()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Represent an unplanned post-publication/daily-operation event and require documented outcomes for affected appointments.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="6700" y="4300" width="620" height="600" as="geometry" /></mxCell><mxCell id="class.c30-39" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:12px&quot;&gt;OperationalExceptionResolution&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px&quot;&gt;- resolutionId&lt;br/&gt;- action&lt;br/&gt;- outcome&lt;br/&gt;- recordedAt&lt;br/&gt;- reason&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:9px;color:#1F536D&quot;&gt;+ recordOutcome()&lt;br/&gt;+ updateOutcome()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;font-size:8px;font-style:italic;color:#5D6670&quot;&gt;Preserve the documented action and outcome for one Appointment affected by one OperationalException.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#FFFFFF;strokeColor=#314E6B;strokeWidth=2;fontColor=#273D52;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="7500" y="4450" width="600" height="500" as="geometry" /></mxCell><mxCell id="class.note-n1-40" value="&lt;b&gt;N1&lt;/b&gt;&lt;br/&gt;One normalized verified phone identifies one User. The same User may hold multiple approved roles/profiles." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9CC;strokeColor=#B39B33;fontColor=#665B24;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1700" y="1700" width="650" height="250" as="geometry" /></mxCell><mxCell id="class.note-n2-41" value="&lt;b&gt;N2&lt;/b&gt;&lt;br/&gt;remaining = published - held - confirmed - withdrawnToFacility&lt;br/&gt;published cannot increase after PUBLISHED." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9CC;strokeColor=#B39B33;fontColor=#665B24;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="5800" y="3300" width="650" height="210" as="geometry" /></mxCell><mxCell id="class.note-n3-42" value="&lt;b&gt;N3&lt;/b&gt;&lt;br/&gt;New holds use the earliest currently bookable ArrivalGroup. Patients do not choose an arbitrary group." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9CC;strokeColor=#B39B33;fontColor=#665B24;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="6550" y="3250" width="650" height="210" as="geometry" /></mxCell><mxCell id="class.note-n4-43" value="&lt;b&gt;N4&lt;/b&gt;&lt;br/&gt;ReservationHold protects one capacity unit and ends as CONSUMED, EXPIRED, or RELEASED. Exact default duration remains open." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9CC;strokeColor=#B39B33;fontColor=#665B24;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="2100" y="4300" width="650" height="240" as="geometry" /></mxCell><mxCell id="class.note-n5-44" value="&lt;b&gt;N5&lt;/b&gt;&lt;br/&gt;ServiceOffering policy is exactly FULL_PAYMENT_REQUIRED or PAY_AT_FACILITY. No deposit/partial payment." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9CC;strokeColor=#B39B33;fontColor=#665B24;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="7300" y="1050" width="700" height="220" as="geometry" /></mxCell><mxCell id="class.note-n6-45" value="&lt;b&gt;N6&lt;/b&gt;&lt;br/&gt;ReservationHold, Appointment, PaymentIntent, VisitInstance, and QueueEntry states are independent and must not be collapsed." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9CC;strokeColor=#B39B33;fontColor=#665B24;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="3450" y="4500" width="720" height="210" as="geometry" /></mxCell><mxCell id="class.note-n7-46" value="&lt;b&gt;N7&lt;/b&gt;&lt;br/&gt;PAY_AT_FACILITY creates no PaymentIntent. Refund is full collected amount or zero." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9CC;strokeColor=#B39B33;fontColor=#665B24;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="4350" y="4850" width="650" height="190" as="geometry" /></mxCell><mxCell id="class.note-n8-47" value="&lt;b&gt;N8&lt;/b&gt;&lt;br/&gt;Accepted late Patient keeps the original Appointment/ArrivalGroup and uses manual queue handling; no auto-transfer or re-entry." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9CC;strokeColor=#B39B33;fontColor=#665B24;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="5950" y="5200" width="700" height="220" as="geometry" /></mxCell><mxCell id="class.note-n9-48" value="&lt;b&gt;N9&lt;/b&gt;&lt;br/&gt;OperationalException cannot close until every affected Appointment has a documented action/outcome." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9CC;strokeColor=#B39B33;fontColor=#665B24;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="6700" y="5150" width="720" height="210" as="geometry" /></mxCell><mxCell id="class.note-n10-49" value="&lt;b&gt;N10&lt;/b&gt;&lt;br/&gt;Aafiatak is not an HIS/EHR/cashier/accounting/full internal scheduling system and stores no clinical record content." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9CC;strokeColor=#B39B33;fontColor=#665B24;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="2500" y="1700" width="720" height="210" as="geometry" /></mxCell><mxCell id="relation.r01-50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6C7A89;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="class.c01-10" target="class.c02-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="mult-51" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="878" y="890.0" width="38" height="20" as="geometry" /></mxCell><mxCell id="mult-52" value="0..1" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="958" y="630.0" width="38" height="20" as="geometry" /></mxCell><mxCell id="relation.r02-53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6C7A89;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="class.c01-10" target="class.c03-12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="mult-54" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="878" y="890.0" width="3